<component type="desktop-application">
  <id>io.github.etf.axiomd</id>
  <name>axiomd</name>
  <summary>Read and write Markdown documents</summary>

  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>

  <developer id="io.github.etf">
    <name>Illya Yalovyy</name>
  </developer>

  <description>
    <p>
      axiomd is a fast, native Markdown viewer and editor for modern GNOME. It
      opens a document instantly, renders it faithfully to the CommonMark and
      GitHub Flavored Markdown specifications, and stays responsive with many
      windows and very large files.
    </p>
    <p>Reading leads, and everything a day of work needs is built in:</p>
    <ul>
      <li>First-class tables, images, code highlighting, math and diagrams</li>
      <li>An outline sidebar and search that follow the document as you read</li>
      <li>An editor with live preview, and a reading position that survives switching between them</li>
      <li>Printing and export to PDF and standalone HTML</li>
      <li>Live reload when a document changes on disk, without losing your place</li>
    </ul>
    <p>
      Documents never reach the network on their own: every asset axiomd renders
      with is bundled, and a remote image is loaded only when you press its
      placeholder.
    </p>
  </description>

  <launchable type="desktop-id">io.github.etf.axiomd.desktop</launchable>

  <provides>
    <mediatype>text/markdown</mediatype>
  </provides>

  <categories>
    <category>Office</category>
    <category>Viewer</category>
  </categories>

  <keywords>
    <keyword>markdown</keyword>
    <keyword>md</keyword>
    <keyword>readme</keyword>
    <keyword>notes</keyword>
  </keywords>

  <url type="homepage">https://github.com/IllyaYalovyy/axiomd</url>
  <url type="bugtracker">https://github.com/IllyaYalovyy/axiomd/issues</url>
  <url type="vcs-browser">https://github.com/IllyaYalovyy/axiomd</url>


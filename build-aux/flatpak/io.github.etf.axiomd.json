{
    "id": "io.github.etf.axiomd",
    "runtime": "org.gnome.Platform",
    "runtime-version": "49",
    "sdk": "org.gnome.Sdk",
    "sdk-extensions": [
        "org.freedesktop.Sdk.Extension.rust-stable"
    ],
    "command": "axiomd",
    "finish-args": [
        "--socket=wayland",
        "--socket=fallback-x11",
        "--share=ipc",
        "--device=dri",
        "--share=network",
        "--filesystem=host:ro"
    ],
    "cleanup": [
        "/include",
        "/lib/pkgconfig",
        "/share/man"
    ],
    "build-options": {
        "append-path": "/usr/lib/sdk/rust-stable/bin",
        "env": {
            "CARGO_HOME": "/run/build/axiomd/cargo",
            "CARGO_NET_OFFLINE": "true"
        }
    },
    "modules": [
        {
            "x-comment": "The one library axiomd links that the GNOME 49 runtime does not ship. Probed on org.gnome.Platform//49 and org.gnome.Sdk//49 (2026-08-03): gtksourceview-5 5.18.0 and enchant-2 2.8.2 are both there, libspelling is not. Built here at the version the development machine has, with everything that is not the library itself switched off.",
            "name": "libspelling",
            "buildsystem": "meson",
            "config-opts": [
                "-Ddocs=false",
                "-Dsysprof=false",
                "-Dvapi=false",
                "-Dintrospection=disabled"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://download.gnome.org/sources/libspelling/0.4/libspelling-0.4.9.tar.xz",
                    "sha256": "d093fd35ae0f1c98fb58876505287fc0a885e47da9d2411d6d7cd595f34d4ebf"
                }
            ]
        },
        {
            "name": "axiomd",
            "buildsystem": "simple",
            "build-commands": [
                "cargo --offline build --release --locked --bin axiomd",
                "scripts/install.sh --prefix /app --binary target/release/axiomd"
            ],
            "sources": [
                {
                    "type": "dir",
                    "path": "../..",
                    "skip": [
                        "target",
                        ".git",
                        "build-aux/flatpak/.flatpak-builder",
                        "build-aux/flatpak/build"
                    ]
                },
                "cargo-sources.json"
            ]
        }
    ]
}
